# ──────────────────────────────────────────────────────────────
# WELD environment example — copy to .env for local development.
# NEVER commit a real .env. See SECURITY.md.
# ──────────────────────────────────────────────────────────────

# PostgreSQL (used by docker compose; api connects here)
POSTGRES_USER=weld
POSTGRES_PASSWORD=weld-dev-only
POSTGRES_DB=weld

# API
# Compose/Docker:
# DATABASE_URL=postgresql+psycopg://weld:weld-dev-only@postgres:5432/weld
# Local host run (python -m venv backend/.venv):
DATABASE_URL=postgresql+psycopg://weld:weld-dev-only@localhost:5432/weld
# Hermetic test runs may instead use: sqlite+pysqlite:///<path>/weld-test.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Game Director (M1) -----------------------------------------------------
# The Director tries each provider below in order and uses the first that
# returns a valid Game Bible. Leave ALL keys empty to use the honest
# deterministic offline composer instead. Put real keys ONLY in your local
# git-ignored .env — never in this file.
#
# Primary: Fireworks (OpenAI-compatible) — GLM 5.3, with Kimi K3 as fallback.
# FIREWORKS_API_KEY=
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# FIREWORKS_MODEL=accounts/fireworks/models/glm-5p3-flash
# FIREWORKS_MODEL_FALLBACK=accounts/fireworks/models/kimi-k3
#
# Fallback: Google AI Studio — Gemini Flash.
# Use a real AI Studio API key (starts with "AIza"), not an OAuth token.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
#
# Fallback: OpenRouter (OpenAI-compatible).
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
#
# Generic single-provider override (tried first if set):
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# DIRECTOR_TIMEOUT_SECONDS=60

# Web (server-side only — the browser never sees internal URLs)
# Local dev:
WELD_API_URL=http://localhost:8000
# Docker compose (service name):
# WELD_API_URL=http://api:8000
# Absolute base for OG/canonical URLs (read by src/app/layout.tsx metadataBase).
WELD_SITE_URL=http://localhost:3000
