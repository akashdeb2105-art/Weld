# ──────────────────────────────────────────────────────────────
# WELD environment example — copy to .env for local development.
# NEVER commit a real .env. See SECURITY.md.
# ──────────────────────────────────────────────────────────────

# PostgreSQL (used by docker compose; api connects here)
POSTGRES_USER=weld
POSTGRES_PASSWORD=weld-dev-only
POSTGRES_DB=weld

# API
# Compose/Docker:
# DATABASE_URL=postgresql+psycopg://weld:weld-dev-only@postgres:5432/weld
# Local host run (python -m venv apps/api/.venv):
DATABASE_URL=postgresql+psycopg://weld:weld-dev-only@localhost:5432/weld
# Hermetic test runs may instead use: sqlite+pysqlite:///<path>/weld-test.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Web (server-side only — the browser never sees internal URLs)
# Local dev:
WELD_API_URL=http://localhost:8000
# Docker compose (service name):
# WELD_API_URL=http://api:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
