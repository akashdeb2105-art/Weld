# Dependencies
node_modules/
.pnp.*

# Builds
dist/
build/
.next/
out/
frontend/.next/
frontend/out/
# Regenerated on every build by frontend/scripts/copy-sample-game.mjs — a
# committed copy just goes stale (and once masked a broken copy path).
frontend/public/sample-game/

# Test artifacts
coverage/
test-results/
playwright-report/
playwright/.cache/
blob-report/
frontend/test-results/
e2e/.tmp/
*.lcov

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Environment / secrets — never commit real env files
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*

# Logs
*.log

# TS incremental build info
*.tsbuildinfo

# Local tooling
.turbo/
.vercel/
.netlify/
