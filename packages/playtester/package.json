{
  "name": "@weld/playtester",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic, engine-free playtester. Proves the WELD quality gates (builds, boots, controls, win reachable, lose reachable, restart) with evidence, not vibes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@weld/engine": "*",
    "@weld/gamebible": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
